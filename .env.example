# Copy to .env and fill in from Neon Console → your project → (Auth | Data API).
# These are public URLs (safe in the app bundle); security comes from the user's JWT + Postgres RLS.
EXPO_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
EXPO_PUBLIC_NEON_DATA_API_URL=https://ep-xxx.apirest.ap-southeast-1.aws.neon.tech/neondb/rest/v1

# Only for the one-time "Import from Google Drive" migration (optional).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
