<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- New bank SMS → quick-add card over the current app (or a notification). Off until the user turns it on. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <receiver
      android:name=".SmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!-- Its own task (affinity) so saving returns to whatever app was open, not to Pettagam. -->
    <activity
      android:name=".QuickAddActivity"
      android:exported="false"
      android:theme="@style/Theme.Pettagam.QuickAdd"
      android:taskAffinity="com.pettagam.app.quickadd"
      android:launchMode="singleTask"
      android:excludeFromRecents="true"
      android:screenOrientation="portrait"
      android:windowSoftInputMode="adjustResize"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />

    <!-- Home-screen widget: today's spending and an Add button (figures written by the app). -->
    <receiver android:name=".SpendWidget" android:exported="false" android:label="Pettagam">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/pettagam_widget_info" />
    </receiver>
  </application>
</manifest>
